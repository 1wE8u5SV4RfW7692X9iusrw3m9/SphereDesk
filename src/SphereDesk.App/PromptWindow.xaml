<Window x:Class="SphereDesk.App.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding TitleText}"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource App.Background}">
    <StackPanel Margin="20">
        <TextBlock Text="{Binding LabelText}" Foreground="{StaticResource App.Muted}" Margin="0,0,0,8" />
        <TextBox x:Name="InputBox" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Style="{StaticResource ChromeButton}" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="确定" Style="{StaticResource ChromeButton}" IsDefault="True" Click="OnAccept" />
        </StackPanel>
    </StackPanel>
</Window>
