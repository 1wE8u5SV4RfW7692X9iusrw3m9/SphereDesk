<Window x:Class="SphereDesk.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:SphereDesk.App"
        Title="SphereDesk"
        Width="1100"
        Height="760"
        MinWidth="720"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource App.Background}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource App.Panel}" BorderBrush="{StaticResource App.Line}" BorderThickness="0,0,0,1">
            <DockPanel Margin="12,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="刷新" Style="{StaticResource ChromeButton}" Command="{Binding RefreshCommand}" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Content="设置" Style="{StaticResource ChromeButton}" Click="OnSettingsClick" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Content="帮助" Style="{StaticResource ChromeButton}" Click="OnHelpClick" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Content="—" Style="{StaticResource ChromeButton}" Click="OnMinimizeClick" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Content="✕" Style="{StaticResource ChromeButton}" Click="OnCloseClick" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Left" Text="SphereDesk" VerticalAlignment="Center" FontSize="16" Margin="4,0,16,0" />
                <TextBox x:Name="SearchBox" shell:WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Center" Margin="0,8" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索名称，Enter 打开，Esc 清空" />
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource App.Panel}" BorderBrush="{StaticResource App.Line}" BorderThickness="0,0,1,0" Padding="12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Button Content="新建分组" Style="{StaticResource ChromeButton}" HorizontalAlignment="Stretch" Command="{Binding CreateGroupCommand}" />
                    <Button Content="重命名分组" Style="{StaticResource ChromeButton}" HorizontalAlignment="Stretch" Command="{Binding RenameGroupCommand}" />
                    <Button Content="删除分组" Style="{StaticResource ChromeButton}" HorizontalAlignment="Stretch" Command="{Binding DeleteGroupCommand}" />
                    <Button Content="加入分组" Style="{StaticResource ChromeButton}" HorizontalAlignment="Stretch" Command="{Binding AddToGroupCommand}" />
                    <Button Content="移出当前分组" Style="{StaticResource ChromeButton}" HorizontalAlignment="Stretch" Command="{Binding RemoveFromGroupCommand}" />
                    <Button Content="重新均匀排列" Style="{StaticResource ChromeButton}" HorizontalAlignment="Stretch" Command="{Binding RebalanceCommand}" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Text="分组" Foreground="{StaticResource App.Muted}" Margin="4,0,0,8" />
                <ListBox x:Name="GroupList" ItemsSource="{Binding Groups}" DisplayMemberPath="Name" AutomationProperties.Name="分组列表" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="180" />
            </Grid.RowDefinitions>
            <Border Background="#3A2A1A" Padding="12,6" Visibility="{Binding IsSynthetic, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="当前为合成数据，不是真实桌面。样例不能打开真实文件。" TextWrapping="Wrap" />
            </Border>
            <local:SphereView x:Name="Sphere" Grid.Row="1" AutomationProperties.Name="桌面球面" />
            <TextBlock Grid.Row="1" Text="{Binding EmptyText}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource App.Muted}" FontSize="16" IsHitTestVisible="False" TextWrapping="Wrap" TextAlignment="Center" Margin="24" />
            <TextBlock Grid.Row="1" Text="{Binding HoverText}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16" Foreground="{StaticResource App.Text}" IsHitTestVisible="False" />
            <DockPanel Grid.Row="2">
                <ComboBox x:Name="KindFilter" DockPanel.Dock="Top" Margin="8" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                <ListBox x:Name="ItemList" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedRow}" AutomationProperties.Name="桌面项目列表" MouseDoubleClick="OnItemDoubleClick" KeyDown="OnItemKeyDown" BorderBrush="{StaticResource App.Line}" BorderThickness="0,1,0,0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding KindLabel}" Foreground="{StaticResource App.Muted}" />
                            <TextBlock Grid.Column="2" Text="{Binding StatusLabel}" Foreground="{StaticResource App.Muted}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            </DockPanel>
        </Grid>

        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource App.Panel}" BorderBrush="{StaticResource App.Line}" BorderThickness="0,1,0,0" Padding="12,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding FailureText}" Foreground="#F7768E" VerticalAlignment="Center" />
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="{StaticResource App.Muted}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
